# Copy this file to .env.local and fill it in. .env.local is ignored by git.
#
# Which data layer the app uses:
#   demo      local sample data in the browser (the default, needs nothing else)
#   supabase  the real backend: Postgres, Auth and Storage on your Supabase project
VITE_BACKEND=demo

# Only used when VITE_BACKEND=supabase.
#
# Put ONLY browser-safe values here: the project URL, and the publishable key
# (it starts with sb_publishable_) or the older anon key.
# Both are in the Supabase dashboard under Project Settings, API Keys.
#
# NEVER put a secret key (sb_secret_...) or a service_role key in any VITE_ variable.
# Vite copies every VITE_ variable into the public website, so anyone could read it.
# The app refuses to start, and the build fails, if it finds one.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
